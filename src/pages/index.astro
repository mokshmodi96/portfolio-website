---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Hey, I'm Moksh.</p>
    <h1>I build web and mobile products with a focus on clarity and speed.</h1>
    <p class="lead">
      Currently exploring product design, AI tooling, and developer experience.
      Based in India and open to thoughtful collaborations.
    </p>
    <div class="hero-actions">
      <a class="link" href="mailto:mokshmodi96@gmail.com">Say hi</a>
      <a class="link muted" href="/projects">View projects</a>
    </div>
  </section>

  <section class="section">
    <h2>Now</h2>
    <ul class="list">
      <li>Building full-stack products and design systems.</li>
      <li>Experimenting with AI-driven workflows and agents.</li>
      <li>Sharpening systems design and architecture skills.</li>
      <li>Shipping small, useful tools when time allows.</li>
    </ul>
  </section>

  <section class="section">
    <h2>Featured</h2>
    <div class="stack">
      <a class="card" href="/projects">
        <span class="card-title">Signal Board</span>
        <span class="card-meta">Product</span>
        <p class="card-desc">A minimalist status dashboard for teams.</p>
      </a>
      <a class="card" href="/projects">
        <span class="card-title">Pulse</span>
        <span class="card-meta">Project</span>
        <p class="card-desc">An AI-assisted habit tracker with daily prompts.</p>
      </a>
      <a class="card" href="/blog/">
        <span class="card-title">Hello World</span>
        <span class="card-meta">Post</span>
        <p class="card-desc">Starting the writing habit with short notes.</p>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="section-row">
      <h2>Recent Writing</h2>
      <a class="link muted" href="/blog/">View all →</a>
    </div>
    <div class="stack">
      <a class="card" href="/blog/">
        <span class="card-title">Testing notes</span>
        <span class="card-meta">Jan 2024</span>
        <p class="card-desc">
          Quick thoughts and work-in-progress updates from current projects.
        </p>
      </a>
      <a class="card" href="/blog/">
        <span class="card-title">Hello World</span>
        <span class="card-meta">Jun 2023</span>
        <p class="card-desc">First post on the blog.</p>
      </a>
    </div>
  </section>
</BaseLayout>
